# Настройки сервера. Скопируйте в .env и заполните. Файл .env не коммитится.

# Адрес и порт. За обратным прокси оставьте 127.0.0.1.
HOST=127.0.0.1
PORT=3000

# Файл базы SQLite. Каталог создаётся автоматически.
DB_FILE=./data/app.sqlite

# Секрет подписи cookie сессии. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=

# Сколько подготовок в день доступно без оплаты.
FREE_PREPS_PER_DAY=1

# Установите 1, если сервер стоит за HTTPS-прокси: cookie получит флаг Secure.
TRUST_PROXY=0

# Провайдер модели. Политика продукта — только модели с открытыми весами:
#   mock | yandex | gigachat | openai_compatible | cerebras | groq | fireworks | together | openrouter
# Закрытые (anthropic | openai | gemini) отклоняются; обход AI_ALLOW_CLOSED_PROVIDERS=1 —
# только для сравнительной оценки на обезличенных данных.
# Для данных с персональными данными предпочтительна обработка в РФ или локальная модель.
AI_PROVIDER=mock
AI_ALLOW_CLOSED_PROVIDERS=0
AI_MODEL=
AI_API_KEY=
# Только для GigaChat: ключ авторизации. Токен доступа по нему получается и обновляется сам.
# Если задан AI_AUTH_KEY, AI_API_KEY можно оставить пустым.
AI_AUTH_KEY=
AI_SCOPE=GIGACHAT_API_PERS
# Для YandexGPT: идентификатор каталога. Для локальной модели: адрес сервиса.
AI_FOLDER_ID=
AI_ENDPOINT=
AI_LOCALE=ru-RU
AI_TIMEOUT_MS=60000

# Управление контекстом.
# CONTEXT_POLICY=policy — жёсткие пределы по задачам (shared/context/policy.js), запрос не
# отправляется, если не помещается; legacy — прежние широкие бюджеты слоёв (для сравнения).
CONTEXT_POLICY=policy
# 1 — память интервью и подбор подтверждений (FTS5) в запросах интервью; 0 — окно и свёртка
# как раньше. Снимок подготовки закрепляется всегда: правка резюме не подменяет контекст интервью.
CONTEXT_MEMORY=0

# Импорт вакансии по ссылке (server/lib/url-import.js). Внутренние адреса запрещены всегда;
# список ниже — только для проверок и разработки: хост:порт через запятую, которым разрешён
# частный адрес и нестандартный порт. В production оставить пустым.
# URL_IMPORT_ALLOW_HOSTS=
# Адаптер hh.ru (docs/hh.md): вакансия по ссылке из публичного API, резюме по публичной
# ссылке, поиск вакансий. Контакт обязателен по правилам hh; токен нужен только для
# методов по договору. Адреса ниже подменяются лишь в проверках.
# HH_CONTACT=you@example.com
# HH_TOKEN=
# HH_API_BASE=https://api.hh.ru
# HH_SITE_BASE=https://hh.ru
# 1 — рассуждение модели подтверждённо выключено: резерв на ответ меньше, входу остаётся больше.
# Подтверждение — документация модели и фактический запрос, не поле общего адаптера.
AI_THINKING_OFF=0
# Путь к tokenizer.json модели для точного подсчёта (нужен пакет @huggingface/tokenizers).
# Без него — консервативная оценка, помеченная как неточная.
TOKENIZER_JSON=

# Уровень журнала: debug | info | warn | error
LOG_LEVEL=info

# Сколько дней хранить данные сессии, к которой не обращались. 0 — не удалять.
DATA_RETENTION_DAYS=90

# Ограничение частоты: запросов к API в минуту с одного адреса и запросов к модели
# в минуту с одной сессии.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_EXPENSIVE_PER_MINUTE=12
# Новых сессий в час с одного адреса: защита от сброса cookie ради обнуления лимитов.
RATE_LIMIT_SESSIONS_PER_HOUR=60

# Токен владельца для /api/admin/*. Пусто — token-доступ выключен; usage доступен роли admin.
# Сгенерировать: openssl rand -hex 32
ADMIN_TOKEN=

# Несколько профилей: полная схема и placeholder-пример — docs/providers.md.
# JSON содержит только имена env, ключи никогда не отправляйте в Telegram/git.
# AI_PROFILES_JSON={"fast":{"provider":"FAST_PROVIDER","model":"FAST_MODEL","apiKey":"CEREBRAS_API_KEY"}}
# AI_TASK_ROUTES_JSON={"assistant.hint":"fast","interview.turn":"fast"}
# AI_DEFAULT_PROFILE=legacy
# FAST_PROVIDER=cerebras
# FAST_MODEL=<fast-model-id>
# CEREBRAS_API_KEY=<key-only-in-private-env>
# AI_MAX_TOKENS_FIELD=max_completion_tokens
# AI_MAX_OUTPUT_TOKENS=1500

# STT отдельно от AI. Эти же переменные читает и веб-сервер для POST /api/stt/transcribe
# (провайдер «Сервер Easyjob» в виджете): whisper_cpp должен быть запущен рядом с сервером
# на локальном адресе; mock НЕ распознаёт речь и помечается заглушкой. Electron получает
# их из окружения запуска. STT_TIMEOUT_MS — предел на один фрагмент (по умолчанию 20000).
STT_PROVIDER=mock
STT_ENDPOINT=http://127.0.0.1:8080/inference

# Синтез речи на сервере для голосовой тренировки (POST /api/tts/speak). В браузере есть
# встроенный вариант без сервера (Web Speech API). mock — тишина с пометкой заглушки;
# piper_http — Piper (piper1-gpl, python3 -m piper.http_server -m ru_RU-irina-medium.onnx);
# openai_compatible — /v1/audio/speech (Kokoro-FastAPI, openedai-speech, облачные сервисы),
# TTS_API_KEY остаётся на сервере. TTS_VOICE — имя голоса, TTS_MODEL — модель для совместимых.
TTS_PROVIDER=mock
# TTS_ENDPOINT=http://127.0.0.1:5000/
# TTS_VOICE=ru_RU-irina-medium
# TTS_MODEL=
# TTS_API_KEY=
# TTS_FORMAT=wav
# TTS_TIMEOUT_MS=15000

# Рекомендуемый шаблон A/B; раскомментировать после проверки каталога и заполнения ключей.
# Модели — заменяемые ID, проверены в публичных каталогах 2026-09-07.
# PREP_PROVIDER=openrouter
# PREP_MODEL=qwen/qwen3.7-plus
# REASON_MODEL=qwen/qwen3.8-max-0902
# LIVE_PROVIDER=cerebras
# LIVE_MODEL=qwen-3.8-27b
# OPENROUTER_API_KEY=
# CEREBRAS_API_KEY=
# AI_PROFILES_JSON={"prep":{"provider":"PREP_PROVIDER","model":"PREP_MODEL","apiKey":"OPENROUTER_API_KEY"},"reason":{"provider":"PREP_PROVIDER","model":"REASON_MODEL","apiKey":"OPENROUTER_API_KEY"},"live":{"provider":"LIVE_PROVIDER","model":"LIVE_MODEL","apiKey":"CEREBRAS_API_KEY"}}
# AI_STAGE_ROUTES_JSON={"pre_interview":"prep","live_interview":"live"}
# AI_TASK_ROUTES_JSON={"resume.review":"reason","match.requirements":"reason","interview.summary":"reason"}
# AI_DEFAULT_PROFILE=legacy

# USD за 1M input/output токенов. Пустая карта = цена неизвестна, не бесплатный вызов.
AI_PRICES_JSON={}
AI_PRICING_VERSION=unconfigured
# Формат (нули — только placeholders, заменить по каталогам перед использованием):
# AI_PRICES_JSON={"openrouter":{"qwen/qwen3.7-plus":{"input":0,"output":0},"qwen/qwen3.8-max-0902":{"input":0,"output":0}},"cerebras":{"qwen-3.8-27b":{"input":0,"output":0}}}
# AI_PRICING_VERSION=catalog-YYYY-MM-DD

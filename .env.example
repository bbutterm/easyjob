# Настройки сервера. Скопируйте в .env и заполните. Файл .env не коммитится.

# Адрес и порт. За обратным прокси оставьте 127.0.0.1.
HOST=127.0.0.1
PORT=3000

# Файл базы SQLite. Каталог создаётся автоматически.
DB_FILE=./data/app.sqlite

# Секрет подписи cookie сессии. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=

# Сколько подготовок в день доступно без оплаты.
FREE_PREPS_PER_DAY=1

# Установите 1, если сервер стоит за HTTPS-прокси: cookie получит флаг Secure.
TRUST_PROXY=0

# Провайдер модели: mock | yandex | gigachat | openai_compatible | anthropic | openai | gemini
# Для данных с персональными данными выбирайте сервис с обработкой в РФ.
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=
# Только для GigaChat: ключ авторизации. Токен доступа по нему получается и обновляется сам.
# Если задан AI_AUTH_KEY, AI_API_KEY можно оставить пустым.
AI_AUTH_KEY=
AI_SCOPE=GIGACHAT_API_PERS
# Для YandexGPT: идентификатор каталога. Для локальной модели: адрес сервиса.
AI_FOLDER_ID=
AI_ENDPOINT=
AI_LOCALE=ru-RU
AI_TIMEOUT_MS=60000

# Уровень журнала: debug | info | warn | error
LOG_LEVEL=info

# Сколько дней хранить данные сессии, к которой не обращались. 0 — не удалять.
DATA_RETENTION_DAYS=90

# Ограничение частоты: запросов к API в минуту с одного адреса и запросов к модели
# в минуту с одной сессии.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_EXPENSIVE_PER_MINUTE=12
# Новых сессий в час с одного адреса: защита от сброса cookie ради обнуления лимитов.
RATE_LIMIT_SESSIONS_PER_HOUR=60

# Токен владельца для /api/admin/*. Пусто — маршруты выключены.
# Сгенерировать: openssl rand -hex 32
ADMIN_TOKEN=

# Настройки сервера. Скопируйте в .env и заполните. Файл .env не коммитится.

# Адрес и порт. За обратным прокси оставьте 127.0.0.1.
HOST=127.0.0.1
PORT=3000

# Файл базы SQLite. Каталог создаётся автоматически.
DB_FILE=./data/app.sqlite

# Секрет подписи cookie сессии. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=

# Сколько подготовок в день доступно без оплаты.
FREE_PREPS_PER_DAY=1

# Установите 1, если сервер стоит за HTTPS-прокси: cookie получит флаг Secure.
TRUST_PROXY=0

# Провайдер модели: mock | yandex | gigachat | openai_compatible | anthropic | openai | gemini
# Для данных с персональными данными выбирайте сервис с обработкой в РФ.
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=
# Для YandexGPT: идентификатор каталога. Для локальной модели: адрес сервиса.
AI_FOLDER_ID=
AI_ENDPOINT=
AI_LOCALE=ru-RU
AI_TIMEOUT_MS=60000

# Уровень журнала: debug | info | warn | error
LOG_LEVEL=info
